# Copy to .env and fill in. Never commit .env.

# OpenRouter key for the language-model step (Voice Mode). Without it, PetoiX
# still runs and uses the deterministic keyword-rule planner for every request.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Serial / Bluetooth port of the Bittle X (Windows: COM5, macOS: /dev/cu.*, Linux: /dev/rfcomm0)
COM_PORT=COM5
BAUD_RATE=115200

# Optional
# FLASK_HOST=127.0.0.1                 # keep the robot API off the classroom network
# INTERACTION_LOG_PATH=interaction_logs.jsonl
